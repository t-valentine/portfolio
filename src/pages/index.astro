---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<style>
  h3 {
    margin-top: 5px;
    padding-top: 0;
  }
  @media all and (max-width: 650px) {
    .two-p div:last-of-type h3:first-of-type {
      padding-top: 10px;
    }
  }
</style>
<BaseLayout>
  <div class="two-p">
    <div>
      <h3>Most Recent Work: Upon the Starship Cenoby!</h3>
      <p>
        A comic about Calliope, one of the main characters for my WIP comic
        Florere.
      </p>
      <p style="font-weight: 800; text-align:center">
        Read it on <a href="https://ccanthology1.thecomicseries.com/comics/45">
          ComicFury
        </a> or <a href="https://namicomi.com/en/chapter/p5mNHNee">NamiComi</a>
      </p>
      <img
        src="https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:feycibfoi5nhzsslmchtjzob/bafkreiejbfzb72u44zcwsctupro6cclo5c23wd6qtzpyxzwalomlkv5jjq"
        style="width: 100%;"
      />
    </div>
    <div>
      <p>
        I'm still getting this new astro website up to speed. I still need to...
      </p>
      <input type="checkbox" id="0" name="0" value="0" checked />
      <label for="0"> Set up art gallery tags</label><br />
      <input type="checkbox" id="1" name="1" value="1" />
      <label for="1"> Hook up the blog</label><br />
      <input type="checkbox" id="2" name="2" value="2" />
      <label for="2"> Create a non-webcomics recommendation page</label><br />
      <p></p>
      <h3>Other Pages on this Site</h3>
      <ul>
        <li>
          <a href="/misc/pkmnmatch">Pokemon Match</a>
        </li>
        <li><a href="/misc/webcomics">Find more webcomics</a></li>
        <li><a href="/misc/webhelp">Webhelp</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
